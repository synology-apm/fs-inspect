# The common sections come first; what only this repository makes goes under "This repository".

# Build output
/target/

# Python
__pycache__/
*.py[cod]
*.egg-info/
/.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Scratch files: disk images made by hand or by tests, atomic writes, downloads
*.img
*.vhd
*.vhdx
*.tmp~
*.part

# Local agent and editor state
/.claude/
/.vscode/
/.idea/
*.swp
*~

# Operating system metadata (Finder, Explorer)
.DS_Store
._*
.AppleDouble/
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# This repository
/tools/build/
/crates/fs-inspect-py/.venv/
/crates/fs-inspect-py/python/fs_inspect/*.pyd
/crates/fs-inspect-py/python/fs_inspect/*.pdb
/crates/fs-inspect-py/python/fs_inspect/*.so
